# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/businessos?schema=public"
# Optional: a direct (non-pooled) URL used only by `prisma migrate`.
# MIGRATION_DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# At least 32 characters. BETTER_AUTH_SECRET and AUTH_SECRET are interchangeable.
AUTH_SECRET=
# Absolute origin. Verification and invitation links are built from this.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in is simply unavailable when these are unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="BusinessOS <noreply@mail.businessos.rauhansheikh.com>"

# Template aliases. Each must exist in Resend; the defaults shown are used when
# the variable is unset. Email presentation lives in these templates, not in the
# codebase. Required variables per template:
#   email-verification -> USER_NAME, VERIFICATION_URL
#   password-reset     -> USER_NAME, RESET_URL
#   team-invitation    -> INVITER_NAME, BUSINESS_NAME, ROLE, INVITE_URL
RESEND_VERIFICATION_TEMPLATE_ALIAS=email-verification
RESEND_PASSWORD_RESET_TEMPLATE_ALIAS=password-reset
RESEND_INVITATION_TEMPLATE_ALIAS=team-invitation
