# npm 10.9.2's strict peer resolver crashes with
#   "Cannot read properties of null (reading 'edgesOut')"
# while walking vitest's optional-peer graph (@vitest/browser-* et al).
# The legacy resolver skips that code path. Every peer this project actually
# needs (react, react-dom, next, prisma, @prisma/client, pg) is declared
# explicitly in package.json, so nothing is left uninstalled by this.
# Revisit once npm ships the arborist fix.
legacy-peer-deps=true
