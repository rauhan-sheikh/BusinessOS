generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  OWNER
  ADMIN
  ACCOUNTANT
}

enum TransactionType {
  SALE
  PURCHASE
  PAYMENT_RECEIVED
  PAYMENT_MADE
  OPENING_BALANCE
  ADJUSTMENT
  REVERSAL
}

/// Which side of a party's balance an entry moves. Applies to OPENING_BALANCE
/// and ADJUSTMENT (caller-chosen) and to REVERSAL (derived from the original).
enum BalanceDirection {
  RECEIVABLE
  PAYABLE
}

/// Business-accountability events. Kept as an enum so a typo cannot silently
/// create an unqueryable action, and so the set is discoverable.
enum AuditAction {
  BUSINESS_CREATED
  BUSINESS_SETTINGS_UPDATED
  WORKSPACE_SWITCHED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  MEMBER_INVITED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  INVITATION_ACCEPTED_NEW_USER
  PARTY_CREATED
  PARTY_UPDATED
  PARTY_ARCHIVED
  TRANSACTION_RECORDED
  TRANSACTION_REVERSED
  BALANCE_RECOMPUTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?   @unique
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  businesses            BusinessUser[]
  auditLogs             AuditLog[]
  transactions          Transaction[]
  invitationsSent       Invitation[]
  emailTemplatesUpdated EmailTemplateOverride[]

  @@map("user")
}

model Business {
  id             String                  @id @default(uuid())
  name           String
  legalName      String?
  gstin          String?
  pan            String?
  phone          String?
  email          String?
  address        String?
  currency       String                  @default("INR")
  timezone       String                  @default("Asia/Kolkata")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  users          BusinessUser[]
  parties        Party[]
  transactions   Transaction[]
  auditLogs      AuditLog[]
  invitations    Invitation[]
  emailTemplates EmailTemplateOverride[]
}

model BusinessUser {
  id         String       @id @default(uuid())
  businessId String
  userId     String
  role       BusinessRole @default(OWNER)
  joinedAt   DateTime     @default(now())
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  // findAllByUserId runs on every authenticated request; the composite unique
  // above cannot serve a userId-only lookup (wrong left-most column).
  @@index([userId])
}

model Party {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  phone        String?
  email        String?
  address      String?
  gstin        String?
  pan          String?
  notes        String?
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  balance      PartyBalance?

  @@index([businessId])
  @@index([businessId, isArchived, updatedAt(sort: Desc)])
}

model PartyBalance {
  id              String   @id @default(uuid())
  businessId      String
  partyId         String   @unique
  receivableMinor BigInt   @default(0)
  payableMinor    BigInt   @default(0)
  updatedAt       DateTime @updatedAt
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([businessId])
}

model Transaction {
  id              String            @id @default(uuid())
  businessId      String
  partyId         String
  transactionType TransactionType
  amountMinor     BigInt
  /// Which balance column this entry moves. Required for OPENING_BALANCE,
  /// ADJUSTMENT and REVERSAL; null for types whose direction is implied.
  direction       BalanceDirection?
  /// The business date of the entry, which may be back-dated. Distinct from
  /// createdAt, which records when the row was written and never moves.
  transactionDate DateTime          @default(now())
  notes           String?
  referenceNumber String?

  /// Set only on a REVERSAL, pointing at the entry it reverses. Unique, so a
  /// transaction can be reversed at most once - enforced by the database
  /// rather than by a check-then-act read.
  reversedTransactionId String?      @unique
  reversedTransaction   Transaction? @relation("TransactionReversal", fields: [reversedTransactionId], references: [id], onDelete: Restrict)
  reversal              Transaction? @relation("TransactionReversal")

  createdById String
  createdAt   DateTime @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([businessId, transactionDate(sort: Desc)])
  @@index([businessId, partyId, transactionDate(sort: Desc)])
  @@index([businessId, transactionType, transactionDate(sort: Desc)])
  @@index([partyId])
  @@index([createdById])
}

model AuditLog {
  id         String      @id @default(uuid())
  businessId String
  userId     String
  actionType AuditAction
  metadata   Json
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt(sort: Desc)])
}

/// A workspace's customised wording for one of the BUSINESS-scoped emails in
/// src/lib/email/templates. Absent means the built-in template is used, so this
/// table only ever holds deliberate overrides and deleting a row restores the
/// default. Platform email (verification, password reset) is intentionally not
/// representable here - see EmailTemplateScope.
model EmailTemplateOverride {
  id          String   @id @default(uuid())
  businessId  String
  /// Matches EmailTemplateKey in src/lib/email/templates.
  templateKey String
  subject     String
  html        String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([businessId, templateKey])
}

model EmailList {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Invitation {
  id         String           @id @default(uuid())
  businessId String
  email      String
  role       BusinessRole     @default(ACCOUNTANT)
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  inviterId  String
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a user must not erase the record of who
  // granted workspace access to whom.
  inviter  User     @relation(fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([businessId, status])
  @@index([email])
}
